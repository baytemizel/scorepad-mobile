# EAS / Expo
EAS_PROJECT_ID=
EXPO_UPDATES_URL=

# AdMob (replace with your real IDs for production)
# Test IDs are used by default if these are unset
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
ADMOB_ANDROID_APP_ID=ca-app-pub-6243163976423366~2881851180

ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
ADMOB_BANNER_ANDROID=ca-app-pub-6243163976423366/7621633435
ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-6243163976423366/2457475668

# IAP product IDs (must match App Store Connect / Play Console)
IAP_PRODUCT_PREMIUM=com.oditteknoloji.scorepad.premium

# Firebase service files (paths relative to repo root)
GOOGLE_SERVICES_PLIST=./firebase/GoogleService-Info.plist
GOOGLE_SERVICES_JSON=./firebase/google-services.json

# Firebase Auth — Google Sign-In Web Client ID (required for Google sign-in)
# Firebase Console → Authentication → Sign-in method → Google → "Web SDK configuration"
FIREBASE_GOOGLE_WEB_CLIENT_ID=

# Facebook login (optional). Leave unset to disable; the fbsdk config plugin
# and the Facebook sign-in button are skipped entirely when FACEBOOK_APP_ID is empty.
# FACEBOOK_APP_ID=
# FACEBOOK_CLIENT_TOKEN=
