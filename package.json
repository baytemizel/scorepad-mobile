{
  "name": "scorepad",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-fbsdk-next"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:ios:local": "EAS_NO_VCS=1 eas build --platform ios --profile production --local",
    "build:android:local": "EAS_NO_VCS=1 eas build --platform android --profile production --local",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/jaro": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/analytics": "^21.6.1",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/auth": "^21.6.1",
    "@react-native-firebase/firestore": "^21.6.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.0",
    "expo-application": "~6.0.1",
    "expo-asset": "~11.0.1",
    "expo-av": "~15.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.4",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.0",
    "expo-router": "~4.0.6",
    "expo-screen-orientation": "~8.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.4",
    "expo-tracking-transparency": "~5.0.0",
    "expo-updates": "~0.26.7",
    "i18next": "^23.16.0",
    "intl-pluralrules": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.0.3",
    "react-native": "0.76.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^14.7.1",
    "react-native-mmkv": "^3.1.0",
    "react-native-purchases": "^10.3.0",
    "react-native-purchases-ui": "^10.3.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.12.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
